spring.application.name=habitos
server.port=8080

spring.datasource.url=jdbc:mysql://localhost:3306/habitos_db
spring.datasource.username=TU_USUARIO_MYSQL
spring.datasource.password=TU_PASSWORD_MYSQL

spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=true
spring.jpa.open-in-view=false

spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration

jwt.secret=CLAVE_BASE64_DE_32_BYTES
jwt.expiration=3600000

spring.mail.host=localhost
spring.mail.port=25
app.mail.from=no-reply@tudominio.com

twilio.account-sid=TU_TWILIO_ACCOUNT_SID
twilio.auth-token=TU_TWILIO_AUTH_TOKEN
twilio.sms-from=+10000000000
twilio.whatsapp-from=whatsapp:+14155238886

app.frontend-url=https://tu-dominio
